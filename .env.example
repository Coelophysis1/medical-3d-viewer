# ==========================================
# 医学三维重建可视化平台 - 环境变量配置
# ==========================================
# 复制此文件为 .env 并填写实际值

# Node 环境
NODE_ENV=production

# 站点 URL（用于生成分享链接，生产环境填实际 IP 或域名）
NEXT_PUBLIC_SITE_URL=http://localhost:5000

# 服务端口
PORT=5000
HOSTNAME=0.0.0.0

# ==========================================
# JWT 认证密钥
# ==========================================
# 至少32位随机字符串，可以用 openssl rand -hex 32 生成
JWT_SECRET=your-jwt-secret-at-least-32-chars

# ==========================================
# 初始管理员账号（首次启动时自动创建）
# ==========================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-admin-password

# ==========================================
# 初始医生账号（可选，JSON 数组格式）
# ==========================================
# INITIAL_USERS=[{"username":"doctor1","password":"pass123","role":"doctor"}]

# ==========================================
# PostgreSQL 数据库
# ==========================================
DATABASE_URL=postgresql://postgres:your-password@localhost:5432/medical3d
# 或者分开填写：
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=your-password
# DB_NAME=medical3d

# ==========================================
# 管理后台 IP 白名单（可选，逗号分隔）
# ==========================================
# ADMIN_IP_WHITELIST=127.0.0.1,192.168.1.0/24

# ==========================================
# 登录频率限制（可选，默认 5次/60秒）
# ==========================================
# LOGIN_RATE_LIMIT=5/60
