# ==========================================
# 医学三维重建可视化平台 - 生产环境变量模板
# ==========================================
# 部署到云服务器时，复制此文件为 .env 并填写实际值
# 注意：NEXT_PUBLIC_* 变量在构建时会被内联到前端，修改后需重新构建

# 环境标识（生产环境必须为 production）
NODE_ENV=production

# 站点 URL（用于生成分享链接，必须填真实域名或公网IP）
# 如果配置了域名+HTTPS，填 https://你的域名
NEXT_PUBLIC_SITE_URL=http://你的服务器IP:5000

# 服务端口与监听地址（0.0.0.0 表示允许外部访问）
PORT=5000
HOSTNAME=0.0.0.0

# JWT 密钥（至少32位，用 openssl rand -hex 32 生成）
JWT_SECRET=替换为32位以上随机字符串

# 初始管理员账号（首次启动时自动创建）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=替换为强密码

# SQLite 数据库文件路径
SQLITE_PATH=/opt/medical-3d/data/medical3d.db

# ==========================================
# 可选配置
# ==========================================
# 管理后台 IP 白名单（逗号分隔，支持 CIDR，留空则不限制）
# ADMIN_IP_WHITELIST=127.0.0.1,192.168.1.0/24

# 登录频率限制（次数/秒数）
# LOGIN_RATE_LIMIT=5/60

# 额外初始用户（格式: 用户名:密码:角色，逗号分隔）
# INITIAL_USERS=doctor1:password123:doctor
